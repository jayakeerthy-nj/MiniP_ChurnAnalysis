# ==============================================================================
# Banking Customer Risk & Churn Analytics - Environment Configuration
# Copy this file to .env before starting the platform: cp .env.example .env
# ==============================================================================

# MongoDB Database Connection String
# Use a local MongoDB instance (e.g., mongodb://127.0.0.1:27017/banking_churn_db)
# or your MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/banking_churn_db

# Backend Express API Service
PORT=5000
NODE_ENV=development

# Service URLs for CORS and Internal Routing
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Authentication & Session Security (JWT)
JWT_ACCESS_SECRET=replace_with_secure_access_secret_key_in_production
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret_key_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Machine Learning Microservice (FastAPI on Port 8000)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=aegis_ml_internal_key

# Google Gemini Generative AI (Optional)
# Used for automated customer summaries and executive briefings.
# If omitted or empty, the platform automatically uses deterministic analytical fallbacks.
GEMINI_API_KEY=
