# ============================================================
# Banking Customer Risk & Churn Analytics - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control.
# ============================================================

# --- MongoDB ---
# Local: mongodb://127.0.0.1:27017/banking_churn_db
# Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_URI=mongodb://127.0.0.1:27017/banking_churn_db

# --- Google Gemini AI (optional) ---
# If omitted, the backend uses built-in rule-based fallback responses.
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Backend Server ---
PORT=5000
NODE_ENV=development

# --- URLs ---
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# --- JWT Secrets (use long random strings in production) ---
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string

# --- JWT Expiry ---
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- ML Service ---
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=replace_with_a_shared_internal_key
