# ==============================================================================
# AegisRisk Platform Environment Configuration
# Copy this file to .env and configure the variables below.
# ==============================================================================

# MongoDB Connection String (Local instance or MongoDB Atlas cluster)
MONGODB_URI=mongodb://127.0.0.1:27017/banking_churn_db

# Backend Service Configuration
PORT=5000
NODE_ENV=development

# Application URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# Authentication (JWT Secrets)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_change_in_prod
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Machine Learning Microservice (FastAPI)
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=aegis_ml_internal_key

# Generative AI (Google Gemini) - Optional
# If omitted or left empty, the platform seamlessly uses intelligent rule-based fallbacks.
GEMINI_API_KEY=
