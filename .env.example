# =============================================================================
# Banking Risk & Churn Intelligence Platform - Environment Variables
# =============================================================================

# Server Port
# Note: Port 5001 is used by default to prevent collision with macOS AirPlay Receiver on 5000
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/banking_churn

# JWT Secrets for Authentication & Role-Based Access Control (RBAC)
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=aegis_ml_internal_key

# Optional: Google Gemini API Key for Generative Strategic Summaries
# If omitted, realistic rule-based fallback intelligence summaries are used.
GEMINI_API_KEY=

