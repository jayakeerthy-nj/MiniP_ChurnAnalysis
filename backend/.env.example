# =============================================================================
# Backend Environment Variables
# =============================================================================

# Server Port (5001 avoids macOS AirPlay Receiver port collision on 5000)
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
MONGODB_URI=mongodb://localhost:27017/banking_churn

# JWT Secrets for Authentication & RBAC
JWT_ACCESS_SECRET=your_jwt_access_secret_key_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Machine Learning Service (FastAPI)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=aegis_ml_internal_key

# Optional: Google Gemini API Key for Generative Strategic Summaries
GEMINI_API_KEY=

